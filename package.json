{
  "name": "@ringo/sketchup-mcp",
  "version": "2.0.0",
  "license": "MIT",
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "ringo-sketchup-mcp": "./bin/ringo-sketchup-mcp.mjs"
  },
  "files": [
    "bin/",
    "dist/",
    "extension/",
    "scripts/",
    "docs/",
    "LICENSE",
    "README.md",
    "README.en.md",
    "CHANGELOG.md"
  ],
  "description": "Local SketchUp MCP bridge for ChatGPT, Codex and other MCP agents on Windows and macOS",
  "repository": {
    "type": "git",
    "url": "https://github.com/Ringophilia/Ringo-Sketchup-MCP.git"
  },
  "type": "module",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepack": "npm run build",
    "start": "node dist/mcp-server.js",
    "dev": "tsx src/mcp-server.ts",
    "test": "node --test --import tsx \"test/**/*.test.ts\"",
    "test:coverage": "node --test --experimental-test-coverage --import tsx \"test/**/*.test.ts\"",
    "format": "biome format --write bin src test scripts",
    "format:check": "biome format bin src test scripts",
    "lint": "tsc -p tsconfig.json --noEmit && biome check bin src test scripts",
    "check": "npm run lint && npm run build && npm test",
    "check:ruby": "node scripts/check-ruby.mjs",
    "test:ruby": "node scripts/test-ruby.mjs",
    "install:extension": "node scripts/install.mjs",
    "setup": "node scripts/setup.mjs",
    "profiles": "node scripts/agent-config.mjs --help",
    "package:rbz": "node scripts/package.mjs",
    "version:bump": "node scripts/bump-version.mjs",
    "doctor": "node scripts/doctor.mjs",
    "config:agents": "node scripts/agent-config.mjs",
    "test:live": "node scripts/live-test.mjs",
    "test:references": "node scripts/live-references.mjs",
    "test:performance": "node scripts/live-performance.mjs",
    "test:multi-instance": "node scripts/qa/multi-instance-demo.mjs"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.32.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "2.6.8",
    "@types/node": "^22.0.0",
    "fflate": "^0.8.3",
    "tsx": "^4.23.15",
    "typescript": "^5.7.0"
  }
}
